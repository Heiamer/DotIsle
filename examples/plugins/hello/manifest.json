    "overview": [
      {"kind": "text", "text": "让自己的想法，成为一块积木。"},
      {"kind": "metric", "bind": "counter", "label": "已运行秒数"},
      {"kind": "divider"},
      {"kind": "progress", "bind": "progress", "label": "这一分钟"}
    ],
    "desktop": [
      {"kind": "text", "text": "你好，点屿"},
      {"kind": "metric", "bind": "counter", "label": "已运行秒数"},
      {"kind": "progress", "bind": "progress", "label": "这一分钟"}
    ]
  }
}
